-- ====================================================================
-- CHAT BUBBLE RENDERER (MEMORY DEDICATED COPY SYSTEM)
-- ====================================================================
local function addChatBubble(sender, rawMessage)
    local isUser = (sender == "User")
    local hasCopyBtn = not isUser
    local extraHeight = hasCopyBtn and 30 or 0

    -- Save exact raw code to Lua memory buffer
    local scriptIndex = #StoredScripts + 1
    StoredScripts[scriptIndex] = rawMessage

    local BubbleFrame = Instance.new("Frame")
    BubbleFrame.Size = UDim2.new(1, 0, 0, 0)
    BubbleFrame.BackgroundTransparency = 1
    BubbleFrame.Parent = ChatScroll

    -- Calculate scroll canvas & bubble height safely
    local _, lineCount = rawMessage:gsub("\n", "\n")
    lineCount = lineCount + 1
    local fontHeight = 16
    local calculatedTextHeight = lineCount * fontHeight

    local textBounds = game:GetService("TextService"):GetTextSize(
        rawMessage,
        13,
        isUser and Enum.Font.SourceSans or Enum.Font.Code,
        Vector2.new(300, 50000)
    )

    local finalHeight = math.max(calculatedTextHeight, textBounds.Y) + 20 + extraHeight

    local Bubble = Instance.new("Frame")
    Bubble.BackgroundColor3 = isUser and Color3.fromRGB(50, 90, 210) or Color3.fromRGB(30, 33, 42)
    Bubble.BorderSizePixel = 0
    Bubble.Size = UDim2.new(0, math.clamp(textBounds.X + 24, 120, 380), 0, finalHeight)
    Bubble.Parent = BubbleFrame

    local BubbleCorner = Instance.new("UICorner")
    BubbleCorner.CornerRadius = UDim.new(0, 8)
    BubbleCorner.Parent = Bubble

    local TextLabel = Instance.new("TextBox")
    TextLabel.Size = UDim2.new(1, -16, 1, -12 - extraHeight)
    TextLabel.Position = UDim2.new(0, 8, 0, 6)
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextLabel.Text = rawMessage
    TextLabel.TextXAlignment = Enum.TextXAlignment.Left
    TextLabel.TextYAlignment = Enum.TextYAlignment.Top
    TextLabel.MultiLine = true
    TextLabel.ClearTextOnFocus = false
    TextLabel.TextWrapped = true
    TextLabel.Font = isUser and Enum.Font.SourceSans or Enum.Font.Code
    TextLabel.TextSize = 13
    TextLabel.Parent = Bubble

    if isUser then
        Bubble.Position = UDim2.new(1, -Bubble.Size.X.Offset, 0, 0)
    else
        Bubble.Position = UDim2.new(0, 0, 0, 0)

        local CopyBtn = Instance.new("TextButton")
        CopyBtn.Name = "CopyButton"
        CopyBtn.Size = UDim2.new(0, 110, 0, 24)
        CopyBtn.Position = UDim2.new(0, 8, 1, -28)
        CopyBtn.BackgroundColor3 = Color3.fromRGB(55, 60, 75)
        CopyBtn.Text = "📋 Copy Code"
        CopyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        CopyBtn.Font = Enum.Font.SourceSansBold
        CopyBtn.TextSize = 11
        CopyBtn.Parent = Bubble

        local CopyCorner = Instance.new("UICorner")
        CopyCorner.CornerRadius = UDim.new(0, 5)
        CopyCorner.Parent = CopyBtn

        -- Directly copy from memory table index (never cut off)
        CopyBtn.MouseButton1Click:Connect(function()
            local fullScript = StoredScripts[scriptIndex]
            if copyToClipboard(fullScript) then
                CopyBtn.Text = "✓ Copied All!"
                CopyBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
                task.delay(1.5, function()
                    CopyBtn.Text = "📋 Copy Code"
                    CopyBtn.BackgroundColor3 = Color3.fromRGB(55, 60, 75)
                end)
            else
                CopyBtn.Text = "Copy Failed"
            end
        end)
    end

    BubbleFrame.Size = UDim2.new(1, 0, 0, finalHeight)
    ChatScroll.CanvasSize = UDim2.new(0, 0, 0, ChatListLayout.AbsoluteContentSize.Y + 20)
    ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.CanvasSize.Y.Offset)
end

-- ====================================================================
-- GEMINI API COMMUNICATION WITH MAX TOKEN EXPANSION
-- ====================================================================
local function sendToGemini(userPrompt)
    addChatBubble("User", userPrompt)
    table.insert(ConversationHistory, {
        role = "user",
        parts = { { text = userPrompt } }
    })

    local endpoint = "https://generativelanguage.googleapis.com/v1beta/" .. SELECTED_MODEL_PATH .. ":generateContent?key=" .. API_KEY

    local payload = {
        systemInstruction = {
            parts = { { text = SystemInstruction } }
        },
        contents = ConversationHistory,
        generationConfig = {
            maxOutputTokens = 8192, -- Prevents API truncating long scripts
            temperature = 0.2
        }
    }

    local requestOptions = {
        Url = endpoint,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = HttpService:JSONEncode(payload)
    }

    task.spawn(function()
        local response = sendHttpRequest(requestOptions)

        if response then
            local bodyText = response.Body or response.body
            if bodyText then
                local success, decoded = pcall(function() return HttpService:JSONDecode(bodyText) end)
                if success and decoded and decoded.candidates and decoded.candidates[1] then
                    local replyText = decoded.candidates[1].content.parts[1].text
                    
                    -- Clean residual codeblock backticks
                    replyText = replyText:gsub("^```%w*\n", ""):gsub("\n```$", ""):gsub("^```", ""):gsub("```$", "")

                    table.insert(ConversationHistory, {
                        role = "model",
                        parts = { { text = replyText } }
                    })

                    addChatBubble("Gemini", replyText)
                    return
                elseif decoded and decoded.error then
                    addChatBubble("Gemini", "[API Error]: " .. tostring(decoded.error.message))
                    return
                end
            end
        end

        addChatBubble("Gemini", "[Error]: Request failed. Check executor web permissions.")
    end)
end

-- ====================================================================
-- DYNAMIC MODEL FETCHING
-- ====================================================================
local function fetchAvailableModels(key)
    StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 255)
    StatusLabel.Text = "Connecting to Google API..."
    
    local listEndpoint = "https://generativelanguage.googleapis.com/v1beta/models?key=" .. key
    local requestOptions = {
        Url = listEndpoint,
        Method = "GET"
    }

    task.spawn(function()
        local response = sendHttpRequest(requestOptions)
        if not response then
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusLabel.Text = "HTTP Error: Unable to make request."
            return
        end

        local bodyText = response.Body or response.body
        if not bodyText then
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusLabel.Text = "Empty response received."
            return
        end

        local success, decoded = pcall(function() return HttpService:JSONDecode(bodyText) end)
        if not success or not decoded then
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusLabel.Text = "Failed to parse API response."
            return
        end

        if decoded.error then
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusLabel.Text = "API Error: " .. tostring(decoded.error.message)
            return
        end

        if decoded.models then
            local count = 0
            for _, model in ipairs(decoded.models) do
                local supportsGenerate = false
                if model.supportedGenerationMethods then
                    for _, method in ipairs(model.supportedGenerationMethods) do
                        if method == "generateContent" then
                            supportsGenerate = true
                            break
                        end
                    end
                end

                if supportsGenerate then
                    count = count + 1
                    local cleanName = model.displayName or model.name:gsub("models/", "")
                    local fullPath = model.name

                    local ModelBtn = Instance.new("TextButton")
                    ModelBtn.Size = UDim2.new(1, -10, 0, 42)
                    ModelBtn.BackgroundColor3 = Color3.fromRGB(32, 35, 44)
                    ModelBtn.Text = cleanName .. " (" .. model.name:gsub("models/", "") .. ")"
                    ModelBtn.TextColor3 = Color3.fromRGB(240, 240, 245)
                    ModelBtn.Font = Enum.Font.SourceSansBold
                    ModelBtn.TextSize = 13
                    ModelBtn.Parent = ModelScroll                    local ModelBtnCorner = Instance.new("UICorner")
                    ModelBtnCorner.CornerRadius = UDim.new(0, 6)
                    ModelBtnCorner.Parent = ModelBtn

                    ModelBtn.MouseButton1Click:Connect(function()
                        SELECTED_MODEL_PATH = fullPath
                        ModelFrame.Visible = false
                        TopBarBtn.Visible = true
                        ChatFrame.Visible = true
                        GeminiTitle.Text = "Gemini (" .. model.name:gsub("models/", "") .. ")"

                        ChatFrame:TweenPosition(UDim2.new(0.5, -220, 1, -345), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.4, true)
                        addChatBubble("Gemini", "Hello! What script would you like me to build for you today?")
                    end)
                end
            end

            if count > 0 then
                ModelScroll.CanvasSize = UDim2.new(0, 0, 0, count * 48)
                KeyFrame.Visible = false
                ModelFrame.Visible = true
            else
                StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                StatusLabel.Text = "No generateContent models found for this key."
            end
        end
    end)
end

