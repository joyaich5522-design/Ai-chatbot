-- Universal Clipboard Handler
local function copyToClipboard(str)
    if setclipboard then pcall(setclipboard, str) return true end
    if toclipboard then pcall(toclipboard, str) return true end
    if set_clipboard then pcall(set_clipboard, str) return true end
    if Clipboard and Clipboard.set then pcall(Clipboard.set, str) return true end
    return false
end

-- Helper function for executor HTTP requests
local function sendHttpRequest(options)
    local requestFuncs = {
        request,
        http_request,
        (http and http.request),
        (syn and syn.request),
        (fluxus and fluxus.request)
    }

    for _, fn in ipairs(requestFuncs) do
        if type(fn) == "function" then
            local success, response = pcall(function() return fn(options) end)
            if success and response then
                return response
            end
        end
    end
    return nil
end

